`include "disciplines.vams"

// Digital frequency measurement based on
// The Designer's Guide to Verilog-AMS,
// Chapter 4, Listing 8.
//
// The model measures the period between two consecutive
// rising edges of the digital input clock and computes
// the corresponding frequency.
//
// The original listing uses:
//   `timescale 1ns / 1ps
//   $realtime
//
// Gnucap does not require the original `timescale here.
// $abstime is used instead and returns time in seconds,
// therefore the frequency is calculated directly as 1/dt.
//
// The original initial block is preserved now that
// Gnucap modelgen supports digital initial blocks.

module freq_meas (clk);
   input clk;
   logic clk;
   real last_time;
   real current_time;
   (*desc="freq"*) real freq;


   initial begin
      last_time = 0.0;
      freq = 0.0;
   end

   always @(posedge(clk)) begin
      current_time = $abstime;
      if (last_time > 0.0)
         freq = 1.0 / (current_time - last_time);
      last_time = current_time;
   end

endmodule
