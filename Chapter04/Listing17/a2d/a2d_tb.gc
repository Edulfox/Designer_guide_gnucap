//////////////////////////////////////////////////////////////////////////////
//
// Complete functional verification of the enhanced electrical-to-logic A2D.
//
// Designer's Guide Listing 17.
//
// Model parameters:
//
//   vl = 0.5 V
//   vh = 2.7 V
//   dv = 0.2 V
//   dt = 1 ns
//
// Therefore:
//
//   vlx = vl + dv = 0.7 V
//   vhx = vh - dv = 2.5 V
//
// The test deliberately exercises both possible behaviors:
//
//   First pulse:
//     slow rise  = 100 ns -> must produce X before reaching HIGH
//     fast fall  = 0.5 ns -> must change HIGH -> LOW without X
//
//   Second pulse:
//     fast rise  = 0.5 ns -> must change LOW -> HIGH without X
//     slow fall  = 100 ns -> must produce X before reaching LOW
//
// Two series VPULSE sources generate both pulses without local
// variables, auxiliary logic or a wrapper testbench module.

load mgsim
load vams/vpulse.so
load ./a2d.so

verilog

ground gnd;

.model logic logic delay=1p rise=10p fall=10p vmax=1.0 vmin=0.0 thh=0.75 thl=0.25

// First pulse: slow rising edge and fast falling edge.
vpulse #(.val0(0.0), .val1(3.2), .td(20n), .rise(100n), .fall(0.5n), .width(60n), .period(1u)) slow_rise_source(mid,gnd);

// Second pulse: fast rising edge and slow falling edge.
vpulse #(.val0(0.0), .val1(3.2), .td(300n), .rise(0.5n), .fall(100n), .width(60n), .period(1u)) slow_fall_source(in,mid);

// Enhanced electrical-to-logic converter under test.
a2d #(.vh(2.7), .vl(0.5), .c(100f), .dt(1n), .dv(0.2)) dut(out,in);

// Convert the logic output to an electrical signal.
// LOW = 0 V, X = 0.5 V and HIGH = 1 V with this logic model.
c_d_a #(.model("logic")) output_probe(out_probe_v,out);

print tran v(in) v(out_probe_v)
tran 0 500n 10p > results/a2d.txt
status notime
