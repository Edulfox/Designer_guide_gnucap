load mgsim
load ./clock_gen.so
verilog
ground gnd;
.model logic logic delay=1p rise=5p fall=5p vmax=1
clock_gen #(.cycle(20n)) dut(clk);
c_d_a #(.model("logic")) probe(vclk,clk);
print tran v(vclk)
tran 0 100n 10p > results/clock_gen.txt
status notime
