`include "disciplines.vams"

// Simple clock generator from The Designer's Guide, Chapter 4, Listing 4.
//
// The book uses:
//   initial clk = 0;
//   always #(cycle/2) clk = ~clk;
//
// Current Gnucap/modelgen does not code-generate that procedural-delay form.
// Verilog-AMS permits analog event expressions to trigger digital behavior, so
// the periodic delay is represented by timer() while the output remains a
// digital reg. The first valid timer event establishes a defined 0/1 state;
// startup before that event is subject to the known Gnucap initialization limit.


module clock_gen(clk);

   parameter real cycle = 20n;

   output clk;
   reg clk;

   initial clk = 0;

   always @(timer(cycle/2, cycle/2))
      clk = !clk;

endmodule
