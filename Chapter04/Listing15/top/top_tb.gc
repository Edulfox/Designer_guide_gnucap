// Listing 15 demonstrates a digital clock connected to an analog resistor.
// Current Gnucap does not auto-insert the required D2A connectmodule, so this
// executable test makes that interface explicit with c_d_a.
load mgsim
load ../../../extensions/clock/clock.so
verilog
ground gnd;
.model logic logic delay=1p rise=10p fall=10p vmax=5.0 vmin=0.0
vsource #(.dc(5.0)) enable_source(en,gnd);
clock #(.frecuency(1M)) clock_source(x,en);
c_d_a #(.model("logic")) explicit_interface(xa,x);
resistor #(.r(50k)) r1(xa,gnd);
print tran v(xa)
tran 0 3u 1n > results/top.txt
status notime
