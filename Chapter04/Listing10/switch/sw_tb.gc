//////////////////////////////////////////////////////////////////////////////
//
// Functional verification of the ideal digitally controlled switch.
//
// The analog input is a bipolar sine wave.
// The digital control periodically opens and closes the switch.
//
// Expected behavior:
//
//   s = 1:
//      Switch closed.
//      V(p,n) = 0.
//      Therefore V(n) follows V(p).
//
//   s = 0:
//      Switch open.
//      I(p,n) = 0.
//      The 1 kohm load pulls node n to ground while p continues
//      following the analog input waveform.
//
// This test verifies repeated switching while the analog input
// continuously changes in both polarity and magnitude.

load mgsim
load vams/vpulse.so
load vams/vsine.so
load ./sw.so

verilog

ground gnd;

.model logic logic delay=1p rise=10p fall=10p vmax=1.0 vmin=0.0 thh=0.75 thl=0.25

// Bipolar analog signal: -1 V to +1 V, 25 MHz.
vsine #(.ampl(1.0), .offset(0.0), .freq(25M)) analog_source(p,gnd);

// Digital switch control.
// OFF from 0 to 10 ns.
// ON  from 10 to 30 ns.
// OFF from 30 to 50 ns.
// The sequence repeats every 40 ns.
vpulse #(.val0(0.0), .val1(1.0), .td(10n), .rise(10p), .fall(10p), .width(20n), .period(40n)) control_source(control_drive,gnd);

// Convert the electrical control stimulus to logic.
c_a_d #(.model("logic")) control_converter(s,control_drive);

// Ideal digitally controlled switch.
switch dut(p,n,s);

// Load gives node n a defined value when the ideal switch is open.
resistor #(.r(1k)) load_resistor(n,gnd);

// Convert control back to an electrical probe for plotting.
c_d_a #(.model("logic")) control_probe(control_probe_v,s);

// Simulation results.
print tran v(p) v(n) v(control_probe_v) iter(0)
tran 0 160n 10p > results/sw.txt
status notime
