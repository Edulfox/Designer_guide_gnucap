`include "disciplines.vams"

// Scalar digital inverter from Designer's Guide, Chapter 4, Listing 3.
// Gnucap compatibility: logical negation is used instead of bitwise negation.
// The unsupported wire declaration is omitted; scalar ports use logic directly.
module inverter (q, a);
   output q;
   input a;
   logic a, q;
   assign q = !a;
endmodule
