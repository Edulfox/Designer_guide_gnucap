`include "disciplines.vams"

// Edge-triggered digital D flip-flop from Chapter 4, Listing 5.
// The book's `always @(clk) if(clk)` behavior is preserved using the directly
// supported positive-edge event form.
module dff (q, d, clk);
   output q;
   input d, clk;
   reg q;
   logic q, d, clk;
   always @(posedge(clk))
      q = d;
endmodule
