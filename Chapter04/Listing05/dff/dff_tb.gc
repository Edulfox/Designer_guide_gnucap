load mgsim
load vams/vpulse.so
load ./dff.so
verilog
ground gnd;
.model logic logic delay=1p rise=5p fall=5p vmax=1
vpulse #(.val0(0.0), .val1(1.0), .td(3n), .rise(10p), .fall(10p), .width(7n), .period(18n)) data_source(dv,gnd);
vpulse #(.val0(0.0), .val1(1.0), .td(5n), .rise(10p), .fall(10p), .width(5n), .period(10n)) clk_source(cv,gnd);
c_a_d #(.model("logic")) dconv(d,dv);
c_a_d #(.model("logic")) cconv(clk,cv);
dff dut(q,d,clk);
c_d_a #(.model("logic")) qprobe(qv,q);
print tran v(dv) v(cv) v(qv)
tran 0 60n 10p > results/dff.txt
status notime
