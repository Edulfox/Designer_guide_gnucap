//////////////////////////////////////////////////////////////////////////////
//
// Functional and stress verification of the two-input latch.
//
// The test verifies:
// - independent changes on d1 and d2,
// - transparent operation while en = 0,
// - output retention while en = 1,
// - reopening of the latch with new input values,
// - repeated operation over several enable cycles.

load mgsim
load vams/vpulse.so
load ./latch2.so

verilog

ground gnd;

.model logic logic delay=1p rise=10p fall=10p vmax=1.0 vmin=0.0 thh=0.75 thl=0.25

// d1 changes every 3 ns.
vpulse #(.val0(0.0), .val1(1.0), .td(2n), .rise(10p), .fall(10p), .width(3n), .period(6n)) d1_source(d1_drive,gnd);

// d2 uses a different period so both inputs exercise different combinations.
vpulse #(.val0(0.0), .val1(1.0), .td(4n), .rise(10p), .fall(10p), .width(5n), .period(10n)) d2_source(d2_drive,gnd);

// Active-low latch enable.
// en = 0: latch transparent.
// en = 1: outputs must hold their previous values.
vpulse #(.val0(0.0), .val1(1.0), .td(10n), .rise(10p), .fall(10p), .width(10n), .period(20n)) enable_source(en_drive,gnd);

// Convert the three electrical stimuli to logic.
c_a_d #(.model("logic")) d1_converter(d1,d1_drive);
c_a_d #(.model("logic")) d2_converter(d2,d2_drive);
c_a_d #(.model("logic")) enable_converter(en,en_drive);

// Device under test.
// The original two-bit output is scalarized for Gnucap.
latch2 dut(out0,out1,d1,d2,en);

// Convert logic signals back to electrical probes for direct visualization.
c_d_a #(.model("logic")) d1_probe(d1_probe_v,d1);
c_d_a #(.model("logic")) d2_probe(d2_probe_v,d2);
c_d_a #(.model("logic")) enable_probe(en_probe_v,en);
c_d_a #(.model("logic")) out0_probe(out0_probe_v,out0);
c_d_a #(.model("logic")) out1_probe(out1_probe_v,out1);

print tran v(d1_probe_v) v(d2_probe_v) v(en_probe_v) v(out0_probe_v) v(out1_probe_v) l(d1) l(d2) l(en) l(out0) l(out1) iter(0)
tran 0 80n 5p > results/latch2.txt
