//////////////////////////////////////////////////////////////////////////////
//
// Functional verification of Designer's Guide Listing 18 D2A.
//
// The D2A input is driven by a true digital signal generated by the
// reusable clock module. This avoids driving a logic input directly
// from an analog VPULSE source.

load mgsim
load ../../../common/clock/clock.so
load ./d2a.so

verilog

ground gnd;

.model logic logic delay=1p rise=10p fall=10p vmax=5.0 vmin=0.0

vsource #(.dc(5.0)) supply(vdd,gnd);
vsource #(.dc(5.0)) enable_source(clock_enable,gnd);

clock #(.frecuency(25M)) clock_source(in,clock_enable);

d2a #(.v0(0.0), .v1(5.0), .r0(1k), .r1(1k), .tr(1n), .tf(1n)) dut_down(out_down,in);
d2a #(.v0(0.0), .v1(5.0), .r0(1k), .r1(1k), .tr(1n), .tf(1n)) dut_up(out_up,in);

resistor #(.r(1k)) load_down(out_down,gnd);
resistor #(.r(1k)) load_up(vdd,out_up);

c_d_a #(.model("logic")) input_probe(in_probe_v,in);

print tran v(in_probe_v) v(out_down) v(out_up)
tran 0 120n 10p > results/d2a.txt
status notime
