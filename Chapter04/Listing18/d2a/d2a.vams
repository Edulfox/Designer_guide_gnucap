`include "disciplines.vams"

// Digital-to-analog interface based on Designer's Guide Listing 18.
//
// The digital input selects the Thevenin output voltage and resistance.
// Logic 0 and logic 1 are currently supported.
// The X and Z parameters are retained from the original model, although
// dynamic X and Z states are not currently supported by Gnucap modelgen.

module d2a(out, in);

   parameter real v0 = 0.0;
   parameter real v1 = 5.0;
   parameter real vx = 2.5;
   parameter real vz = 5.0;

   parameter real r0 = 1k from (0:inf);
   parameter real r1 = 1k from (0:inf);
   parameter real rx = 100 from (0:inf);
   parameter real rz = 1M from (0:inf);
   
   parameter real tr = 1n from [0:inf);
   parameter real tf = 1n from [0:inf);

   input in;
   output out;

   logic in;
   electrical out;

   real v;
   real r;

   initial begin
      if (in) begin
         v = v1;
         r = r1;
      end
      else begin
         v = v0;
         r = r0;
      end
   end

   always @(edge(in)) begin
      if (in) begin
         v = v1;
         r = r1;
      end
      else begin
         v = v0;
         r = r0;
      end
   end

   analog begin
      V(out) <+ transition(v, 0, tr, tf)
              + transition(r, 0, tr, tf) * I(out);
   end

endmodule
