// Capability test for Listing 20. This testbench is intentionally kept with the
// standards-faithful source even though the current modelgen snapshot cannot build it.
// Once driver-access support is added, two digital drivers should exercise agreement
// and contention while the analog terminal exposes the resulting Thevenin equivalent.
load mgsim
load ./bidir.so
load ../../../extensions/clock/clock.so
verilog
ground gnd;
.model logic logic delay=1p rise=10p fall=10p vmax=5.0 vmin=0.0
vsource #(.dc(5.0)) enable_source(en,gnd);
clock #(.frecuency(25M)) driver0(d,en);
clock #(.frecuency(12.5M)) driver1(d,en);
bidir dut(a,d);
resistor #(.r(1k)) load(a,gnd);
c_d_a #(.model("logic")) probe(d_probe,d);
print tran v(d_probe) v(a)
tran 0 160n 10p > results/bidir.txt
status notime
