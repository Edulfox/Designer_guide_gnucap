//////////////////////////////////////////////////////////////////////////////
//
// Complete functional verification of the 8-bit ADC.
//
// Analog input:
//   offset    = 0.5 V
//   amplitude = 0.49 V
//   frequency = 5 MHz
//
// Therefore:
//   Vin ranges from approximately 0.01 V to 0.99 V.
//
// Sampling clock:
//   frequency = 100 MHz
//   period    = 10 ns
//   rising edges at 5, 15, 25, 35... ns
//
// The test verifies:
//   - analog-to-digital conversion over most of full scale,
//   - increasing and decreasing input values,
//   - MSB and LSB activity,
//   - output-code retention between sampling edges,
//   - repetitive conversion over more than one input cycle.

load mgsim
load vams/vpulse.so
load vams/vsine.so
load ./adc.so
load ../../../common/clock/clock.so

verilog

ground gnd;

vsource #(.dc(1)) vsupp(enable_drive,gnd);
c_a_d #(.model("logic")) enable_converter(clock_enable,enable_drive);
.model logic logic delay=1p rise=10p fall=10p vmax=1.0 vmin=0.0 thh=0.75 thl=0.25
clock #(.frecuency(100M)) clock_source(clk,clock_enable);



// Analog ADC input: 0.01 V to 0.99 V.
vsine #(.ampl(0.49), .offset(0.5), .freq(5M)) input_source(in,gnd);

// 50 MHz sampling clock.
//vpulse #(.val0(0.0), .val1(1.0), .td(10n), .rise(10p), .fall(10p), .width(10n), .period(20n)) clock_source(clk_drive,gnd);

// Convert the electrical clock stimulus to logic.
//c_a_d #(.model("logic")) clock_converter(clk,clk_drive);

// Eight-bit ADC under test.
adc dut(b7,b6,b5,b4,b3,b2,b1,b0,in,clk);

// Logic-to-electrical probes.
c_d_a #(.model("logic")) clock_probe(clk_probe_v,clk);
c_d_a #(.model("logic")) b7_probe(b7_probe_v,b7);
c_d_a #(.model("logic")) b6_probe(b6_probe_v,b6);
c_d_a #(.model("logic")) b5_probe(b5_probe_v,b5);
c_d_a #(.model("logic")) b4_probe(b4_probe_v,b4);
c_d_a #(.model("logic")) b3_probe(b3_probe_v,b3);
c_d_a #(.model("logic")) b2_probe(b2_probe_v,b2);
c_d_a #(.model("logic")) b1_probe(b1_probe_v,b1);
c_d_a #(.model("logic")) b0_probe(b0_probe_v,b0);

// Simulation results.
print tran v(in) v(clk_probe_v) v(b7_probe_v) v(b6_probe_v) v(b5_probe_v) v(b4_probe_v) v(b3_probe_v) v(b2_probe_v) v(b1_probe_v) v(b0_probe_v) iter(0)
tran 0 420n 10p > results/adc.txt
status notime
