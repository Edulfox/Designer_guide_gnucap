`include "disciplines.vams"

// Basic electrical-to-logic converter based on Designer's Guide Listing 16.
// The original connectmodule is represented as a regular mixed-signal module
// because the current Gnucap model generator does not emit standalone
// prototypes for connectmodule declarations.
module a2d (out, in);

   parameter real vh = 2.7;
   parameter real vl = 0.5;
   parameter real c = 100f;

   input in;
   output out;

   electrical in;

   reg out;
   logic out;

   // Set the digital output when the analog input crosses
   // above the high logic threshold.
   always @(above(V(in) - vh)) begin
      out = 1;
   end

   // Clear the digital output when the analog input crosses
   // below the low logic threshold.
   always @(above(vl - V(in))) begin
      out = 0;
   end

   // Model the input capacitance seen by the analog source.
   analog begin
      I(in) <+ c * ddt(V(in));
   end

endmodule
