`include "disciplines.vams"

// Comparator with logic output from Designer's Guide, Chapter 4, Listing 14.
// `timescale is omitted; digital timing is supplied by the testbench logic model.
module comparator (out, p, n);
   parameter real offset = 0;
   parameter real hyst = 0.0 from [0:inf);
   inout p, n;
   output out;
   electrical p, n;
   reg out;
   logic out;
   parameter real thrlo = offset - 0.5*hyst;
   parameter real thrhi = offset + 0.5*hyst;

   always @(above(V(p, n) - thrhi))
       out = 1;

   always @(above(thrlo - V(p, n)))
       out = 0;
endmodule
