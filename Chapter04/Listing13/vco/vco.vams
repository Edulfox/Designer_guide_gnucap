`include "disciplines.vams"
`include "constants.vams"

// Voltage-controlled oscillator with digital output.
module vco (out, ps, ns);

   parameter real f0 = 100k from (0:inf);
   parameter real kvco = 10k;

   input ps, ns;
   output out;

   electrical ps, ns;
   electrical osc;

   reg out;
   logic out;

   initial out = 0;

   analog begin
      V(osc) <+ sin(`M_TWO_PI * idt(f0 + kvco * V(ps, ns), 0));
   end

   always @(cross(V(osc), 0)) begin
      out = !out;
   end

endmodule
