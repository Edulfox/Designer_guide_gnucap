//////////////////////////////////////////////////////////////////////////////
//
// Complete functional verification of the mixed-signal VCO.
//
// Control-voltage sequence:
//
//   0 - 40 ns    : 0.0 V
//  40 - 80 ns    : 0.5 V
//  80 - 120 ns   : 1.0 V
// 120 - 160 ns   : 0.5 V
// 160 - 220 ns   : 0.0 V
//
// VCO parameters:
//
//   f0   = 100 MHz
//   kvco = 100 MHz/V
//
// Expected output frequencies:
//
//   Vctrl = 0.0 V -> 100 MHz -> T = 10.000 ns
//   Vctrl = 0.5 V -> 150 MHz -> T =  6.667 ns
//   Vctrl = 1.0 V -> 200 MHz -> T =  5.000 ns
//   Vctrl = 0.5 V -> 150 MHz -> T =  6.667 ns
//   Vctrl = 0.0 V -> 100 MHz -> T = 10.000 ns
//
// Two series VPULSE sources generate the required control levels.

load mgsim
load vams/vpulse.so
load ./vco.so

verilog

ground gnd;

.model logic logic delay=1p rise=10p fall=10p vmax=1.0 vmin=0.0 thh=0.75 thl=0.25

vpulse #(.val0(0.0), .val1(0.5), .td(40n), .rise(10p), .fall(10p), .width(120n), .period(500n)) control_base(p_base,gnd);
vpulse #(.val0(0.0), .val1(0.5), .td(80n), .rise(10p), .fall(10p), .width(40n), .period(500n)) control_extra(ps,p_base);

vco #(.f0(100M), .kvco(100M)) dut(out,ps,gnd);

c_d_a #(.model("logic")) output_probe(out_probe_v,out);

print tran v(ps) v(out_probe_v) iter(0)
tran 0 220n 10p > results/vco.txt
status notime
