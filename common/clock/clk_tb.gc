load mgsim
load ./clock.so

verilog

ground gnd;

.model logic logic delay=1p rise=10p fall=10p vmax=1.0 vmin=0.0 thh=0.75 thl=0.25
clock #(.frecuency(100M),.duty(50.0)) clock_source(clk,en);

// Logic-to-electrical probes.
c_d_a #(.model("logic")) clock_probe(clk_probe_v,clk);

// Simulation results.
print tran v(clk_probe_v) v(clk_probe_v) iter(0)
tran 0 420n 10p > results/clk.txt
