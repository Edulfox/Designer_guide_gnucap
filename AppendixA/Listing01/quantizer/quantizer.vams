`include "disciplines.vams"

// N-level quantizer from The Designer's Guide, Appendix A, Listing 1.
module quantizer (out, in, clk);
   parameter integer levels = 2;
   parameter real vh = 1.0;
   parameter real vl = -1.0;
   parameter real vth = (vh + vl)/2.0;
   parameter integer dir = 1;
   parameter real td = 0.0;
   parameter real tt = 0.0;
   output out;
   input in, clk;
   electrical out, in, clk;
   real quantized, delta;
   integer level;
   analog begin
      @(cross(V(clk) - vth, dir) or initial_step) begin
         delta = (vh - vl)/(levels - 1);
         level = (V(in) - vl)/delta;
         if (level < 0)
            level = 0;
         else if (level >= levels)
            level = levels - 1;
         quantized = level*delta + vl;
      end
      V(out) <+ transition(quantized, td, tt);
   end
endmodule
