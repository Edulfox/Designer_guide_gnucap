// Four-level quantizer verification with a slow analog ramp.
load mgsim
load ./quantizer.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(-1.2), .val1(1.2), .td(2n), .rise(40n), .fall(40n), .width(5n), .period(90n)) input_source(in,gnd);
vpulse #(.val0(-1.0), .val1(1.0), .td(1n), .rise(10p), .fall(10p), .width(2.5n), .period(5n)) clock_source(clk,gnd);
quantizer #(.levels(4), .vh(1.0), .vl(-1.0), .vth(0.0), .dir(1), .td(100p), .tt(100p)) dut(out,in,clk);
print tran v(in) v(clk) v(out)
tran 0 90n 20p > results/quantizer.txt
status notime
