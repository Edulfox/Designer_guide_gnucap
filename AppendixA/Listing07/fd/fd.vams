`include "disciplines.vams"

// Frequency divider from Designer's Guide, Appendix A, Listing 7.
// Gnucap compatibility notes:
// - The timescale directive is omitted; timing is defined by the testbench logic model.
// - Scalar logical negation is used because it is exercised by modelgen regressions.
// - The book's internal register q is folded into the output register. Internal
//   procedural logic registers are not code-generated by this snapshot, while
//   procedural assignment to an output reg is regression-tested.
module fd (out, clk, reset);
   input clk, reset;
   output out;
   reg out;
   logic out, clk, reset;
   integer i = 0;

   // The book initializes q on the falling edge of reset.
   always @(negedge(reset)) begin
       i = 0;
       out = 0;
   end

   // In the book, assign out = q & !reset forces the observable output low
   // whenever reset is high. Preserve that externally visible behavior.
   always @(posedge(reset)) begin
       out = 0;
   end

   always @(posedge(clk)) begin
       if (!reset) begin
           i = i + 1;
           if (i == 63) begin
               out = !out;
               i = 0;
           end
       end
   end
endmodule
