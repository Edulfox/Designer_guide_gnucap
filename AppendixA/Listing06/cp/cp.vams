`include "disciplines.vams"

// Charge pump from Designer's Guide, Appendix A, Listing 6.
// `timescale is omitted; digital timing is supplied by the testbench logic model.
module cp (pout, nout, inc, dec);
   parameter real cur = 1m;
   input inc, dec;
   logic inc, dec;
   electrical pout, nout;
   real out;

   analog begin
       @(initial_step) out = 0.0;
       if (dec && !inc)
           out = -cur;
       else if (!dec && inc)
           out = cur;
       else
           out = 0;
       I(pout, nout) <+ -transition(out, 0.0, 10n, 10n);
   end
endmodule
