`include "disciplines.vams"

module vco(out,ps,ns);

parameter real f0=100k;
parameter real kvco=10k;
parameter real tick=1p;

output out;

electrical ps,ns;

reg out;
logic out;

real vin;
real frecuency;
real phase;
real last_time;
real elapsed;

initial begin
out=0;
vin=0.0;
frecuency=f0;
phase=0.0;
last_time=0.0;
end

always @(timer(0,tick)) begin
vin=V(ps,ns);
frecuency=f0+kvco*vin;
elapsed=$abstime-last_time;
last_time=$abstime;
phase=phase+frecuency*elapsed;

if(phase>=0.5) begin
phase=phase-0.5;
out=!out;
end
end

endmodule
