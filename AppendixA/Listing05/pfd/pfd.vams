`include "disciplines.vams"

module pfd(qinc,qdec,active,ref,reset);

output qinc,qdec;
input reset,active,ref;

reg qinc,qdec;
logic qinc,qdec,reset,active,ref;

integer q0=0;
integer q1=0;
integer active_old=0;
integer ref_old=0;

always @(edge(active) or edge(ref)) begin

if(reset) begin
q0=0;
q1=0;
end else begin

if(active&&!active_old) begin
q0=1;
end

if(ref&&!ref_old) begin
q1=1;
end

if(q0&&q1) begin
q0=0;
q1=0;
end

end

qdec=q0;
qinc=q1;

active_old=active;
ref_old=ref;

end

always @(posedge(reset)) begin
q0=0;
q1=0;
qdec=0;
qinc=0;
active_old=active;
ref_old=ref;
end

endmodule
