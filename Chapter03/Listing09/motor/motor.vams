`include "disciplines.vams"

// Multidisciplinary motor with a Gnucap-compatible RL winding formulation.
module motor (shaft, p, n);
   parameter real km = 4.5;
   parameter real kf = 6.2;
   parameter real j = 0.004;
   parameter real d = 0.1;
   parameter real r = 5.0;
   parameter real l = 0.02;
   inout shaft, p, n;
   rotational_omega shaft;
   electrical p, n;
   real imotor;

   analog begin
      imotor = laplace_nd(V(p,n) - km*Omega(shaft), '{1.0}, '{r,l});
      I(p,n) <+ imotor;
      Tau(shaft) <+ kf*imotor - d*Omega(shaft) - j*ddt(Omega(shaft));
   end
endmodule
