load mgsim
load vams/vsine.so
load ./varactor.so
verilog
ground gnd;
vsine #(.dc(0.0), .ampl(1.0), .freq(10M)) source(vin,gnd);
resistor #(.r(1k)) series(vin,vout);
varactor dut(vout,gnd);
print tran v(vin) v(vout)
tran 0 200n 20p > results/varactor.txt
status notime
