`include "disciplines.vams"

// Varactor from Chapter 3, Listing 30.
module varactor (p, n);
   parameter real c0 = 1p from (0:inf);
   parameter real c1 = 0.5p from [0:c0);
   parameter real v0 = 0.0;
   parameter real v1 = 1.0 from (0:inf);
   inout p, n;
   electrical p, n;
   real q, v;
   analog begin
      v = V(p,n);
      q = c0*v + c1*v1*ln(cosh((v-v0)/v1));
      I(p,n) <+ ddt(q);
   end
endmodule
