`include "disciplines.vams"

// Ideal mechanical stop from Chapter 3, Listing 20.
module barrier (p, n);
   inout p, n;
   kinematic p, n;
   analog begin
      @(cross(Pos(p,n) + F(p,n), 0)) ;
      if ((Pos(p,n) + F(p,n)) > 0)
         Pos(p,n) <+ 0.0;
      else
         F(p,n) <+ 0.0;
   end
endmodule
