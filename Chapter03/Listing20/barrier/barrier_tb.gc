// Mechanical-stop verification using the electrical numerical analogy only as
// test stimulus/load. The DUT itself retains the book's kinematic Pos/F ports.
load mgsim
load vams/vsine.so
load ./barrier.so
verilog
ground gnd;
vsine #(.offset(0.0), .ampl(1.0), .freq(1k)) drive(src,gnd);
resistor #(.r(1.0)) load(src,p);
barrier dut(p,gnd);
print tran v(src) v(p)
tran 0 2m 1u > results/barrier.txt
status notime
