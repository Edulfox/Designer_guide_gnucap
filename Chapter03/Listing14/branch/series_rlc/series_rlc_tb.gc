load mgsim
load vams/vpulse.so
load ./series_rlc.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(1u), .rise(1n), .fall(1n), .width(2u), .period(5u)) source(vin,gnd);
series_rlc #(.r(10), .l(10u), .c(10n)) dut(vin,vout);
resistor #(.r(100)) load(vout,gnd);
print tran v(vin) v(vout)
tran 0 10u 5n > results/series_rlc.txt
status notime
