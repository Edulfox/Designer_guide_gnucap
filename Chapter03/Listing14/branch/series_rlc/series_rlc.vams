`include "disciplines.vams"

// Explicit-branch series RLC with a Gnucap-compatible RL formulation.
module series_rlc (p, n);
   parameter real r = 0.0;
   parameter real l = 0.0;
   parameter real c = 0.0;
   inout p, n;
   electrical p, n, i;
   branch (p,i) rl;
   branch (i,n) cap;

   analog begin
      I(rl) <+ laplace_nd(V(rl), '{1.0}, '{r,l});
      I(cap) <+ c*ddt(V(cap));
   end
endmodule
