`include "disciplines.vams"

// Time-interval measurement based on Chapter 3, Listing 25.
// The book uses last_crossing(), which is not implemented in the supplied
// modelgen snapshot. Crossing times are therefore captured with $abstime at
// the cross events. The arming, accumulation, mean calculation, and final
// report remain the same.
module time_interval_measurement (start, stop);
   parameter real thresh = 0.5;
   parameter integer dir = 1;
   input start, stop;
   electrical start, stop;
   (*desc="count"*) integer count = 0;
   integer armed = 0;
   real t0 = 0.0;
   real t1 = 0.0;
   real sum = 0.0;
   (*desc="mean"*) real mean = 0.0;
   analog begin
      @(cross(V(start) - thresh, dir)) begin
         t0 = $abstime;
         armed = 1;
      end
      @(cross(V(stop) - thresh, dir)) begin
         t1 = $abstime;
         if (armed) begin
            armed = 0;
            count = count + 1;
            sum = sum + (t1 - t0);
            mean = sum/count;
         end
      end
      @(final_step) begin
         $strobe("time interval measurements = %d", count);
         if (count)
            $strobe("mean time interval (est) = %g", mean);
         else
            $strobe("Could not measure time interval.");
      end
   end
endmodule
