// Two 50 MHz sine waves cross 0.5 V with a fixed 7 ns rising-edge separation.
// The first stop crossing occurs before the first armed start crossing and is ignored.
load mgsim
load ./time_interval_measurement.so
load vams/vsine.so
verilog
ground gnd;
vsine #(.offset(0.5), .ampl(0.5), .freq(50M), .phase(0.0)) start_source(start,gnd);
vsine #(.offset(0.5), .ampl(0.5), .freq(50M), .phase(2.199114857512855)) stop_source(stop,gnd);
time_interval_measurement #(.thresh(0.5), .dir(1)) dut(start,stop);
print tran v(start) v(stop) count(dut) mean(dut)
tran 0 100n 20p > results/time_interval_measurement.txt
status notime
