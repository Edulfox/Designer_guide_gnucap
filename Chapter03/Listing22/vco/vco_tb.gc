// Control ramps from 0 to 1 V, increasing oscillation frequency from Fmin to Fmax.
load mgsim
load ./vco.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(10n), .rise(150n), .fall(150n), .width(20n), .period(340n)) control(in,gnd);
vco #(.Vmin(0.0), .Vmax(1.0), .Fmin(10M), .Fmax(50M), .ampl(1.0)) dut(out,in);
print tran v(in) v(out)
tran 0 340n 20p > results/vco.txt
status notime
