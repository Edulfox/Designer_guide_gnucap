// Validate finite on resistance and off conductance of the relay.
load mgsim
load ./relay.so
load vams/vpulse.so
verilog
ground gnd;
vsource #(.dc(1.0)) supply(vdd,gnd);
vpulse #(.val0(0.0), .val1(1.0), .td(10n), .rise(20p), .fall(20p), .width(20n), .period(50n)) control(ctrl,gnd);
resistor #(.r(1k)) source_resistor(vdd,p);
relay #(.thresh(0.5), .ron(10.0), .goff(1n)) dut(p,out,ctrl,gnd);
resistor #(.r(1k)) load(out,gnd);
print tran v(ctrl) v(out)
tran 0 100n 10p > results/relay.txt
status notime
