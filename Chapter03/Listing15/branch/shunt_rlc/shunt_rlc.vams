`include "disciplines.vams"

// Explicit-branch shunt RLC with a Gnucap-compatible inductor formulation.
module shunt_rlc (p, n);
   parameter real r = 0.0;
   parameter real l = 0.0;
   parameter real c = 0.0;
   inout p, n;
   electrical p, n;
   branch (p,n) res, cap, ind;

   analog begin
      V(res) <+ r*I(res);
      I(cap) <+ c*ddt(V(cap));

      if (l == 0.0)
         V(ind) <+ 0.0;
      else
         I(ind) <+ idt(V(ind))/l;
   end
endmodule
