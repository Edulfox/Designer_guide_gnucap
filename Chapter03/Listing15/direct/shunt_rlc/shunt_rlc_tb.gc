// Pulse excitation of the direct shunt RLC model.
load mgsim
load ./shunt_rlc.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(2n), .rise(20p), .fall(20p), .width(5n), .period(30n)) source(vin,gnd);
resistor #(.r(1k)) series(vin,node);
shunt_rlc #(.r(2k), .l(1u), .c(100p)) dut(node,gnd);
print tran v(vin) v(node)
tran 0 80n 5p > results/shunt_rlc.txt
status notime
