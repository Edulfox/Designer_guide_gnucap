// Source orientation injects 1 mA into a 1 kOhm load -> about 1 V.
load mgsim
load ./isrc.so
verilog
ground gnd;
isrc #(.dc(1m)) dut(gnd,out);
resistor #(.r(1k)) load(out,gnd);
print tran v(out)
tran 0 10n 10p > results/isrc.txt
status notime
