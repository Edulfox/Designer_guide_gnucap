// Bipolar ramp through a source resistor demonstrates one-way conduction.
load mgsim
load ./diode.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(-1.0), .val1(1.0), .td(2n), .rise(20n), .fall(20n), .width(10n), .period(60n)) source(vin,gnd);
resistor #(.r(1k)) series(vin,out);
diode dut(out,gnd);
print tran v(vin) v(out)
tran 0 70n 20p > results/diode.txt
status notime
