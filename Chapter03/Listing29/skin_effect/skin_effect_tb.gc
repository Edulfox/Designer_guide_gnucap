// Broadband transient excitation of the scalarized 10-lump skin-effect model.
load mgsim
load vams/vpulse.so
load ./skin_effect.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(100n), .rise(5n), .fall(5n), .width(400n), .period(1u)) source(vin,gnd);
resistor #(.r(1.0)) series(vin,vout);
skin_effect #(.r0(1.0), .f0(1k), .f1(10M)) dut(vout,gnd);
print tran v(vin) v(vout)
tran 0 3u 1n > results/skin_effect.txt
status notime
