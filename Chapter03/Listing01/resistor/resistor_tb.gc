// 1 kOhm DUT with a 1 kOhm source resistance gives a 0.5 V divider output.
load mgsim
load ./resistor.so
verilog
ground gnd;
vsource #(.dc(1.0)) source(vin,gnd);
resistor #(.r(1k)) series(vin,vout);
resistor #(.r(1k)) dut(vout,gnd);
print tran v(vin) v(vout)
tran 0 10n 10p > results/resistor.txt
status notime
