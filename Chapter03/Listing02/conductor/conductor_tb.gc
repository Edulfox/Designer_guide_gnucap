// A 1 mS conductor is equivalent to 1 kOhm and forms a 1:1 divider.
load mgsim
load ./conductor.so
verilog
ground gnd;
vsource #(.dc(1.0)) source(vin,gnd);
resistor #(.r(1k)) series(vin,vout);
conductor #(.g(1m)) dut(vout,gnd);
print tran v(vin) v(vout)
tran 0 10n 10p > results/conductor.txt
status notime
