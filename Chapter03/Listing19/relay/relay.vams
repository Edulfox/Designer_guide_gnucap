`include "disciplines.vams"

// Non-ideal relay without a switch branch.
module relay (p, n, ps, ns);
   parameter real thresh = 0.0;
   parameter real ron = 0.0;
   parameter real goff = 0.0;
   inout p, n;
   input ps, ns;
   electrical p, n, ps, ns;

   analog begin
      @(cross(V(ps,ns) - thresh, 0))
         $discontinuity(0);
      if (V(ps,ns) > thresh)
         I(p,n) <+ V(p,n)/ron;
      else
         I(p,n) <+ goff*V(p,n);
   end
endmodule
