// Forward-voltage sweep using a slow pulse/ramp through a series resistor.
load mgsim
load ./diode.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(0.9), .td(2n), .rise(40n), .fall(40n), .width(5n), .period(90n)) source(vin,gnd);
resistor #(.r(1k)) series(vin,a);
diode #(.is(10f), .tf(0.0), .cjo(0.0), .phi(0.7)) dut(a,gnd);
print tran v(vin) v(a)
tran 0 90n 20p > results/diode.txt
status notime
