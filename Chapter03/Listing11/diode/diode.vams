`include "disciplines.vams"

// Junction diode from The Designer's Guide, Chapter 3, Listing 11.
module diode (a, c);
   parameter real is = 10f;
   parameter real tf = 0.0;
   parameter real cjo = 0.0;
   parameter real phi = 0.7;
   inout a, c;
   electrical a, c;
   branch (a, c) res, cap;
   real qd;
   analog begin
      I(res) <+ is*(limexp(V(res)/$vt) - 1.0);
      qd = tf*I(res) - 2.0*cjo*phi*sqrt(1.0 - V(cap)/phi);
      I(cap) <+ ddt(qd);
   end
endmodule
