// RL step response verifies V=L*dI/dt behavior.
load mgsim
load ./inductor.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(2n), .rise(20p), .fall(20p), .width(20n), .period(50n)) source(vin,gnd);
resistor #(.r(1k)) series(vin,vout);
inductor #(.l(1u)) dut(vout,gnd);
print tran v(vin) v(vout)
tran 0 60n 5p > results/inductor.txt
status notime
