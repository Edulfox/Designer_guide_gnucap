`include "disciplines.vams"

// Ideal relay controlled by an analog threshold crossing.
module relay (p, n, ps, ns);
   parameter real thresh = 0.0;
   output p, n;
   input ps, ns;
   electrical p, n, ps, ns;

   analog begin
      @(cross(V(ps,ns) - thresh, 0)) begin
      end
      if (V(ps,ns) > thresh)
         V(p,n) <+ 0.0;
      else
         I(p,n) <+ 0.0;
   end
endmodule
