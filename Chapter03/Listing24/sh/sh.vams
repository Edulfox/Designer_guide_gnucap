`include "disciplines.vams"

// Smoothed periodic self-clocked sample-and-hold from Chapter 3, Listing 24.
module sh (p, n, ps, ns);
   parameter real period = 1.0;
   parameter real toff = 0.0;
   parameter real td = 0.0;
   parameter real tt = period/100.0;
   input ps, ns;
   output p, n;
   electrical p, n, ps, ns;
   real save;
   analog begin
      @(timer(toff, period) or initial_step)
         save = V(ps,ns);
      V(p,n) <+ transition(save, td, tt);
   end
endmodule
