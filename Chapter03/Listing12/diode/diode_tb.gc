// DC-current stress through the implicit series resistance formulation.
load mgsim
load ./diode.so
load vams/vsine.so
verilog
ground gnd;
vsine #(.offset(0.4), .ampl(0.4), .freq(1M)) source(vin,gnd);
resistor #(.r(1k)) series(vin,a);
diode #(.is(10f), .r(10)) dut(a,gnd);
print tran v(vin) v(a)
tran 0 2u 1n > results/diode.txt
status notime
