// Slow 0..1 V ramp sampled by a 10 ns analog clock.
load mgsim
load ./adc.so
load vams/vpulse.so
load vams/vsine.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(1n), .rise(80n), .fall(80n), .width(5n), .period(170n)) input_source(in,gnd);
vsine #(.offset(0.5), .ampl(0.5), .freq(100M), .phase(3.141592653589793)) clock_source(clk,gnd);
adc #(.fullscale(1.0), .vdd(1.0), .thresh(0.5), .dir(1), .td(100p), .tt(100p)) dut(b0,b1,b2,b3,b4,b5,b6,b7,in,clk);
print tran v(in) v(clk) v(b7) v(b6) v(b5) v(b4) v(b3) v(b2) v(b1) v(b0)
tran 0 170n 20p > results/adc.txt
status notime
