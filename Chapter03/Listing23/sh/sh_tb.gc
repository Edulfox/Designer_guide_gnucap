// Slowly varying input sampled every 10 ns.
load mgsim
load ./sh.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(0), .rise(40n), .fall(40n), .width(5n), .period(90n)) input_source(in,gnd);
sh #(.period(10n), .toff(0.0)) dut(out,gnd,in,gnd);
print tran v(in) v(out)
tran 0 90n 20p > results/sh.txt
status notime
