`include "disciplines.vams"
`include "constants.vams"

// Resistive port using a Gnucap-compatible Norton-equivalent formulation.
module port (p, n);
   parameter real r = 50.0;
   parameter real dc = 0.0;
   parameter real mag = 0.0;
   inout p, n;
   electrical p, n;

   analog begin
      I(p,n) <+ V(p,n)/r - 2.0*dc/r;
      I(p,n) <+ ac_stim("ac", 2.0*mag/r);
      I(p,n) <+ white_noise(4.0*`P_K*$temperature/r, "thermal");
   end
endmodule
