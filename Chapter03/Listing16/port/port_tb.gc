// Validate DC, AC, and thermal-noise behavior of the resistive port.
load mgsim
load ./port.so
verilog
ground gnd;
port #(.r(50.0), .dc(0.5), .mag(1.0)) dut(out,gnd);
resistor #(.r(50.0)) load(out,gnd);
noise_probe #(.name("thermal")) nthermal(out);
print tran v(out)
tran 0 10n 10p > results/port_tran.txt
print ac v(out) nv(nthermal) npwr(nthermal)
ac 1 1G * 10 > results/port_ac_noise.txt
status notime
