// Transient step response of the complete lossy-inductor network.
load mgsim
load vams/vpulse.so
load ../../Listing29/skin_effect/skin_effect.so
load ./lossy_ind.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(100n), .rise(5n), .fall(5n), .width(400n), .period(1u)) source(vin,gnd);
resistor #(.r(50.0)) series(vin,vout);
lossy_ind dut(vout,gnd);
print tran v(vin) v(vout)
tran 0 3u 1n > results/lossy_ind.txt
status notime
