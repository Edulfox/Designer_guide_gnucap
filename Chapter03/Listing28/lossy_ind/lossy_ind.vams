`include "disciplines.vams"
`include "constants.vams"

// Lossy inductor from Chapter 3, Listing 28.
module lossy_ind (t1, t2);
   parameter real esr = 0.01;
   parameter real rcp = 1.0;
   parameter real cp = 10f;
   parameter real l = 1n;
   parameter real h = 70k;
   electrical t1, t2, n1, n2;
   inout t1, t2;
   resistor #(.r(rcp)) Rp(n2,t2);
   skin_effect #(.r0(esr), .f0(2*esr*esr*h*h), .f1(1/(2*`M_PI*sqrt(l*cp)))) Hr(t1,n1);
   capacitor #(.c(cp)) Cp(t1,n2);
   inductor #(.l(l)) L(n1,t2);
endmodule
