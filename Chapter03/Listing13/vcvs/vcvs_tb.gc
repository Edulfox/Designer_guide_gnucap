// Gain-of-two verification using a ramp input and a resistive load.
load mgsim
load ./vcvs.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(0.5), .td(2n), .rise(20n), .fall(20n), .width(10n), .period(60n)) source(in,gnd);
vcvs_model #(.gain(2.0)) dut(out,gnd,in,gnd);
resistor #(.r(10k)) load(out,gnd);
print tran v(in) v(out)
tran 0 70n 20p > results/vcvs.txt
status notime
