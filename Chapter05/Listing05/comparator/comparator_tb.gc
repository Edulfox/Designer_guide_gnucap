// Differential ramp crosses a fixed 0.5 V reference in both directions.
load mgsim
load ./comparator.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(2n), .rise(20n), .fall(20n), .width(10n), .period(60n)) input_source(pin,gnd);
vsource #(.dc(0.5)) reference(nin,gnd);
comparator #(.td(200p), .tt(200p)) dut(out,pin,nin);
print tran v(pin) v(nin) v(out)
tran 0 70n 20p > results/comparator.txt
status notime
