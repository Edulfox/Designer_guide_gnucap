`include "disciplines.vams"

// Comparator from The Designer's Guide, Chapter 5, Listing 5.
module comparator (out, pin, nin);
   parameter real td = 1n;
   parameter real tt = 1n;
   output out;
   input pin, nin;
   electrical out, pin, nin;
   real Vout;
   analog begin
      @(cross(V(pin) - V(nin), 0))
         ;
      Vout = (V(pin) > V(nin)) ? 1.0 : 0.0;
      V(out) <+ transition(Vout, td, tt);
   end
endmodule
