// Pseudo-random bit sequence; period chosen for an easily readable trace.
load mgsim
load ./bitstream.so
verilog
ground gnd;
bitStream #(.start(1n), .period(5n), .seed_init(7)) dut(out);
print tran v(out)
tran 0 100n 20p > results/bitstream.txt
status notime
