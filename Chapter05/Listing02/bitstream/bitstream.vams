`include "disciplines.vams"

// Pseudo-random bit-stream generator based on Chapter 5, Listing 2.
// The book uses $random. Current Gnucap/modelgen provides $rdist_uniform
// but not $random, so a uniform distribution is used to preserve the
// one-random-decision-per-timer-event behavior.
module bitStream (out);
   parameter real start = 0.0;
   parameter real period = 1.0;
   parameter integer seed_init = 1;
   output out;
   electrical out;
   integer x;
   integer seed = seed_init;
   real r;
   analog begin
      @(timer(start, period)) begin
         r = $rdist_uniform(seed, -1.0, 1.0, "instance");
         x = (r >= 0.0) ? 1 : 0;
      end
      V(out) <+ transition(x, 0.0, period/100.0);
   end
endmodule
