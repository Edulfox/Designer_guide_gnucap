`include "disciplines.vams"

// Breakdown sentinel from The Designer's Guide, Chapter 5, Listing 4.
module breakdown (n);
   parameter real threshold = 1000.0;
   parameter string message = "Warning: breakdown voltage exceeded.";
   input n;
   electrical n;
   (*desc="given"*) integer given = 0;
   analog begin
      @(above(V(n) - threshold)) begin
         if (!given)
            $strobe(message);
         given = 1;
      end
   end
endmodule
