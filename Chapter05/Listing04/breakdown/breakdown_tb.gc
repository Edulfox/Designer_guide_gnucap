// A sinusoidal source crosses the breakdown threshold repeatedly.
// The sentinel must set given=1 on the first upward crossing and keep it set.
load mgsim
load ./breakdown.so
load vams/vsine.so
verilog
ground gnd;
vsine #(.offset(4.0), .ampl(2.0), .freq(20M)) source(n,gnd);
breakdown #(.threshold(5.0)) dut(n);
print tran v(n) given(dut)
tran 0 100n 20p > results/breakdown.txt
status notime
