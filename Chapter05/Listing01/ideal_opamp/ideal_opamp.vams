`include "disciplines.vams"

// Ideal opamp from The Designer's Guide, Chapter 5, Listing 1.
// Gnucap/modelgen supports indirect contributions, so the original
// behavioral equation is preserved.
module ideal_opamp (pout, nout, pin, nin);
   output pout, nout;
   input pin, nin;
   electrical pin, nin, pout, nout;
   branch (pout, nout) out;
   branch (pin, nin) in;
   analog begin
      V(out): V(in) == 0;
   end
endmodule
