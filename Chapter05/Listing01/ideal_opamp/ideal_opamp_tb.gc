// Voltage-follower verification of the ideal opamp.
load mgsim
load ./ideal_opamp.so
load vams/vpulse.so
verilog
ground gnd;
vpulse #(.val0(0.0), .val1(1.0), .td(5n), .rise(10n), .fall(10n), .width(20n), .period(60n)) input_source(vin,gnd);
ideal_opamp dut(vout,gnd,vin,vout);
resistor #(.r(10k)) load(vout,gnd);
print tran v(vin) v(vout)
tran 0 120n 20p > results/ideal_opamp.txt
status notime
