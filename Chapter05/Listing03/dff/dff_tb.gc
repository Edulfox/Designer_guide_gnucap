load mgsim
verilog
load ./dff.so
load vams/vpulse.so
ground gnd;

dff #(.dir(1)) dut(q, d, clk);
vpulse #(.val0(0.0), .val1(1.0), .td(5n), .rise(20p), .fall(20p), .width(20n), .period(40n)) d_source(d, gnd);
vpulse #(.val0(0.0), .val1(1.0), .td(10n), .rise(20p), .fall(20p), .width(5n), .period(20n)) clk_source(clk, gnd);
print tran v(clk) v(d) v(q) iter(0)
tran 0 160n 0 20p > results/dff.txt
status notime
