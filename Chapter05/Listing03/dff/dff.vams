`include "disciplines.vams"

// D flip flop.
module dff (q, d, clk);
   parameter integer dir = +1 from [-1:+1] exclude 0;
             // if dir=+1, rising clock edge triggers flip flop
             // if dir=-1, falling clock edge triggers flip flop
   output q;                         // Q output
   input clk;                        // Clock input (edge triggered)
   input d;                          // D input
   electrical q, clk, d;
   integer state;
   analog begin
       @(cross(V(clk) - 0.5, dir))
           state = (V(d) > 0.5);
       V(q) <+ transition(state ? 1 : 0, 0, 0);
   end
endmodule
