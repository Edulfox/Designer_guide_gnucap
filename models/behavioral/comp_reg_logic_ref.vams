// Original digital-logic registered comparator from comp/comp_reg.
// The clock and the outputs are logic nets; comp_reg_logic_tb.gc bridges
// them to the analog domain with elect_to_logic / logic_to_elect.

`include "disciplines.vams"

module comparator_reg(outp, outn, inp, inn, clk, vdd, vss);
    parameter real vos = 0.0;
    parameter real meta = 0.0 from [0:inf);
    output outp, outn;
    reg outp, outn;
    input inp, inn, clk, vdd, vss;

    logic outp, outn, clk;
    electrical inp, inn, vdd, vss;

    always @(posedge(clk)) begin
            if (V(inp) - V(inn) + vos > meta) begin
                outp = 1;
                outn = 0;
            end 
            else begin
                outp = 0;
                outn = 1;
            end
    end
    always @(negedge(clk)) outp = 1;
    always @(negedge(clk)) outn = 1;

endmodule
