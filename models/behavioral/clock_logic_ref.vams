// Original digital-logic clock from comp/comp_reg: a gated 50 % square
// wave on a logic net, used through a c_d_a connect module.

`include "disciplines.vams"

module clock(out, en);
  output out;
  input en;
  logic out, en;
  assign #10000 out = !out & en;
endmodule
